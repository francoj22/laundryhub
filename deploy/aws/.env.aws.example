# AWS region where your DynamoDB tables exist
AWS_REGION=us-east-1
CF_STACK_NAME=laundry-dynamodb
CF_FULL_STACK_NAME=laundry-full-stack
PROJECT_NAME=laundry

# DynamoDB tables used by the services
DYNAMODB_SUBMISSIONS_TABLE=submissions
DYNAMODB_PAYMENTS_TABLE=payments

# Keep false in AWS because tables should be provisioned explicitly
DYNAMODB_AUTO_CREATE_TABLE=false

# Leave empty for real AWS DynamoDB
DYNAMODB_ENDPOINT=

# Internal DNS names when running via Docker Compose on one EC2 host
SERVICES_SUBMISSIONS_URL=http://submissions-service:8082
SERVICES_PAYMENTS_URL=http://payments-service:8083

# Minimum 32-byte secret for JWT signing
SECURITY_JWT_SECRET=replace-with-a-strong-32-byte-secret

# Required for one-shot EC2 + DynamoDB CloudFormation deployment
EC2_KEY_PAIR_NAME=replace-with-existing-keypair
GIT_REPO_URL=https://github.com/your-org/laundry.git
GIT_REPO_BRANCH=main

# Optional for one-shot full stack
EC2_INSTANCE_TYPE=t3.small
ALLOWED_SSH_CIDR=0.0.0.0/0
ALLOWED_HTTP_CIDR=0.0.0.0/0

# Optional custom domain via ALB + ACM + Route53
ENABLE_ALB_HTTPS=false
VPC_ID=
PUBLIC_SUBNET_ONE_ID=
PUBLIC_SUBNET_TWO_ID=
ACM_CERTIFICATE_ARN=
CUSTOM_DOMAIN_NAME=
HOSTED_ZONE_ID=
